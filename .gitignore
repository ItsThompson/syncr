# Python toolchain
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml
dist/
build/
*.egg-info/

# Node toolchain
node_modules/
*.tsbuildinfo
coverage/

# What a Playwright run leaves behind: traces, screenshots and the HTML report. Evidence about one
# run rather than anything a reader of the tree needs, and CI uploads it as an artifact instead.
e2e/test-results/
e2e/playwright-report/

# Secrets and local config. .env.example is committed; .env is not.
.env
.env.*
!.env.example

# The Alertmanager webhook URL. Read from a file because Alertmanager performs no environment
# expansion in its own configuration, and written by the deploy path from the host's secret store.
deployments/alertmanager/webhook_url

# THE RELEASE'S RECORDED IMAGE DIGESTS, written on the host by `cd.yml` and by `just deploy`, and
# read by every ops recipe. Ignored for two reasons: the host's `git status` stays readable after a
# deploy so a real change is visible, and `git clean -fd` no longer removes it. `just drill-local`
# refuses when it is present, so deleting it re-enables the one path that would dump the live
# database under a throwaway key. See `docs/runbooks/deploy-and-rollback.md`, "what pins what".
deployments/digests.env
deployments/digests.previous.env

# OS noise
.DS_Store
