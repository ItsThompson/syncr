# Every minute, measured from the previous ACTIVATION.
#
# `OnUnitActiveSec` is relative to when the unit was last activated, not to when it finished:
# `OnUnitInactiveSec` is the from-the-end one. So a fifty-second run is followed ten seconds later,
# and what makes an overlap impossible is `TimeoutStartSec=45s` in the service, which is under this
# interval. `AccuracySec` is tightened from systemd's one-minute default, which would otherwise let
# the interval drift to two minutes and put the recovery point outside its objective.
#
# No `Persistent=true`: a missed minute of shipping is caught up by the next run, which drains
# everything staged. The nightly dump carries that flag because a missed DAY is not caught up.

[Unit]
Description=syncr WAL shipping, every minute
Documentation=file:/opt/syncr/docs/runbooks/backup-stale.md

[Timer]
OnBootSec=2min
OnUnitActiveSec=60s
AccuracySec=5s
Unit=syncr-walship.service

[Install]
WantedBy=timers.target
