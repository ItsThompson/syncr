# The nightly backup. Installed on the host; see docs/runbooks/deploy-and-rollback.md.
#
# It runs `just backup-now`, which is the SAME command a person runs by hand, so the schedule and a
# manual run cannot drift into two procedures. That includes the digest pins: `ops_compose`'s DEFAULT
# carries them, so this unit sets no compose seam and a human invocation resolves the same images.
#
# `docker compose` reads the project's own `.env` for interpolation, and that file IS the host secret
# file: mode 0600, never in the repository, holding the bucket credentials, the Postgres password, and
# the two encryption keys. The release's digests come from `deployments/digests.env`, which the recipe
# reads. Nothing is passed on this unit's command line.

[Unit]
Description=syncr nightly backup: dump, verify, encrypt, upload off-host, prune, publish
Documentation=file:/opt/syncr/docs/runbooks/backup-stale.md
# The dump needs the database up. `docker compose` starts nothing here, so this is an ordering
# statement rather than a dependency: a run while Docker is still starting fails loudly and the timer
# tries again tomorrow, which BackupStale would report after 36 hours.
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/syncr
ExecStart=/usr/bin/just backup-now
# A run that hangs on a network is a run that must end, or the next one overlaps it. Well inside the
# nightly window and far outside a real dump, which is seconds on a database of this size.
TimeoutStartSec=30min
