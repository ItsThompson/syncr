# The nightly learning run. A TIMER, NOT A SERVICE, and that is a resource decision rather than a
# scheduling one: scipy plus scikit-learn resident is ~800 MB for a job that runs once a day, which is
# 10% of host memory held for a process idle 99.9% of the time.
#
# THE EXIT STATUS IS SYSTEMD'S RECORD RATHER THAN A MONITORED SIGNAL. The container exits non-zero
# when a tenant's fit failed, and `systemctl status syncr-learning` is where that is readable. Nothing
# in the deployment reads it: the node exporter runs without `--collector.systemd`, so no series
# carries a unit's result.
#
# What monitoring reads is the exposition the container writes into the textfile collector before
# exiting, because a container that has exited cannot be scraped. The duration family it reports
# carries no outcome label, so `LearningJobFailed` can see a run that never arrived and not a run that
# arrived and failed.
#
# 03:00, the same hour as the backup, which is why the learning engine turns on `pool_pre_ping`: a
# connection severed by a Postgres restart must be discarded rather than failing a tenant's night.

[Unit]
Description=syncr nightly learning run: fit the objective weights from the outcome log
Documentation=file:/opt/syncr/docs/runbooks/learning-job-failed.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/syncr
# `/usr/bin/env just`, for the reason `syncr-backup.service` states in full: `just` is installed into
# `/usr/local/bin`, and a unit pinning `/usr/bin/just` fails at 203/EXEC on its first firing.
ExecStart=/usr/bin/env just learn-once
# Section 19 budgets the run at under five minutes. Six times that is a hang rather than a slow night.
TimeoutStartSec=30min
