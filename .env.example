# syncr configuration. Copy to .env and adjust; .env is never committed.
#
# One sectioned file serves every consumer: the api, the worker, the learning job,
# and Compose itself. Each member ignores keys it does not declare, so a key added
# for one process does not break another.
#
# Real environment variables always win over this file, which is how Compose and the
# deploy inject values without the file existing at all.

# --- Process configuration --------------------------------------------------
# development enables the strict dotted-event-name check and relaxed defaults.
ENVIRONMENT=development
LOG_LEVEL=info

# --- Database ---------------------------------------------------------------
# The host-run inner loop reaches the Postgres that the dev overlay publishes.
# Inside the Compose stack this is overridden to the in-network @postgres:5432 form.
DATABASE_URL=postgresql+asyncpg://syncr:syncr@localhost:5432/syncr

# Read by Compose to initialize the postgres container.
POSTGRES_USER=syncr
POSTGRES_PASSWORD=syncr
POSTGRES_DB=syncr

# --- Compose itself ---------------------------------------------------------
# NEVER ADD COMPOSE_PROJECT_NAME TO THIS FILE, and never set it in `.env`.
#
# Compose reads that one key above the `name:` every compose file here declares, so a
# value for it silently retargets every stack command at the project it names, including
# the recipes that drop a project's volumes. A key here becomes a key in `.env` for
# whoever follows the first line of this file, and `.env` is gitignored, so nothing that
# reads the repository can see what it did. `just` refuses those recipes when it finds
# the key set, in the shell or in that file; this section is what keeps it unset.

# --- Sessions and origins ---------------------------------------------------
# Every browser session's stored identifier is a keyed digest under this secret, so
# replacing it signs every live session out. That is its documented cost, not a bug:
# rotating it is how every session is invalidated deliberately.
#
# The value below is the development default and is refused outside development: a
# process with ENVIRONMENT set to anything else fails to start rather than issue
# sessions anyone reading this file could forge. Generate a real one with:
#   python -c "import secrets; print('syncrp_' + secrets.token_urlsafe(48))"
SESSION_SIGNING_SECRET=dev-only-session-signing-key-not-for-deployment

# Where the browser may send an unsafe request from, comma separated. This plus
# SameSite=Lax is the whole CSRF defense; no token pattern is added. In the deployed
# stack it is the tunnel hostname; locally it is the Vite dev server and the api's own
# origin, because a same-origin POST carries an Origin header too.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# --- The OAuth Authorization Server -----------------------------------------
# Every URL the Authorization Server publishes is built from this, and never from the
# request host: Cloudflare Tunnel reaches the api as http://api:8000 from inside app-net,
# so a request-derived issuer would advertise URLs no client can reach and would mint
# tokens whose `iss` no client can match. It is also where the access token's audience
# comes from, as <PUBLIC_BASE_URL>/api/v1.
#
# In the deployed stack this is the tunnel hostname, with no trailing slash.
PUBLIC_BASE_URL=http://localhost:8000

# Where the browser application is served from, which is where the Google connect callback sends
# the browser when it is done. PUBLIC_BASE_URL is the origin the api itself answers on; this is the
# origin the browser has in its address bar: one host when a single ingress serves both, and two
# hosts in development.
#
# UNSET OR EMPTY MEANS THE API'S OWN ORIGIN, which is why the key ships with no value: a host
# seeded by copying this file inherits the origin it already serves both halves from, and a
# deployment behind one ingress therefore needs no value here and no line in any runbook.
#
# SET IT FOR THE SPLIT-ORIGIN DEVELOPMENT STACK, where `just dev-frontend` serves the application
# on 5173 and `just dev-api` answers on 8000. Uncomment the line below.
#
#   APP_BASE_URL=http://localhost:5173
#
APP_BASE_URL=

# Where the encrypted OAuth signing keys are read from. LEAVING THIS EMPTY IS A
# DEVELOPMENT-ONLY STATE: development generates an ephemeral keypair in memory and logs
# that it did, and every other environment refuses to start, because keys that change on
# every restart invalidate every access token the previous process issued.
#
# Create the file with `just rotate-oauth-key`, and mount it read-only into the api and
# worker containers. See docs/runbooks/rotate-oauth-signing-key.md.
OAUTH_KEYS_PATH=

# The key that file is encrypted with. A Fernet key: 32 random bytes as URL-safe base64.
# The value below is the development default and is refused outside development whenever
# OAUTH_KEYS_PATH is set, because a signing key encrypted under a key from this repository
# is a signing key in the clear. Generate a real one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Rotating it means re-encrypting the key file with the new value in the same operation:
# the api refuses to start against a file it cannot decrypt, and it says so by name.
OAUTH_KEY_ENCRYPTION_KEY=ZGV2LW9ubHktb2F1dGgta2V5LWVuY3J5cHRpb24ta2U=

# --- Google OAuth -----------------------------------------------------------
# The web-application OAuth client for the one Google integration: the anchor
# sources syncr reads and the single calendar it writes. Provisioning and the
# scope set are in docs/runbooks/google-oauth-verification.md.
#
# Both values live in the host secret file and never in the repository. Leaving
# them empty is a valid state: the stack boots and the connect flow reports that
# Google is not configured, so `just dev` works without them.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Which registered redirect URI this process uses. Google matches redirect URIs
# as exact strings, so this value must appear verbatim on the OAuth client. Three
# are registered: the https://syncr.app form for the deployed stack, and the two
# loopback forms for development.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/calendar-sources/google/callback

# The key each stored Google refresh token is encrypted with at rest. A Fernet key: 32
# random bytes as URL-safe base64, and its own value rather than the OAuth signing key's,
# because the two rotate for different reasons. Rotating this one costs the user a reconnect,
# because a token encrypted under the old key cannot be read back.
#
# The value below is the development default and is refused outside development whenever
# GOOGLE_OAUTH_CLIENT_ID is set: a refresh token encrypted under a key from this repository is
# a refresh token in the clear, and a refresh token is the standing authority to read every
# calendar in the account and to overwrite the one syncr owns. Generate a real one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=ZGV2LW9ubHktZ29vZ2xlLXRva2VuLWVuY3J5cHQta2U=

# Whether syncr may WRITE to the calendar it owns. Off, and off in every environment until a
# person has run the live Google suite against a real account:
#   cd packages/syncr-api && uv run pytest -m google_live
#
# The destructive reconciliation deletes anything inside its horizon that syncr does not intend,
# including events the user created by hand, and no part of it has ever been run against the real
# Google API: obtaining the standing authorization that suite needs takes a human at a consent
# screen. So the write is built, tested against a fake provider, and refused here.
#
# With it off the projection is still computed in full and then refused before any request is sent.
# The refusal is not silent: it raises the same oxide banner a projection failure raises, stating
# that the plan is not reaching the phone and that reading calendars still works.
GOOGLE_PROJECTION_WRITES=false
