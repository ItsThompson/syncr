# syncr configuration. Copy to .env and adjust; .env is never committed.
#
# One sectioned file serves every consumer: the api, the worker, the learning job,
# and Compose itself. Each member ignores keys it does not declare, so a key added
# for one process does not break another.
#
# Real environment variables always win over this file, which is how Compose and the
# deploy inject values without the file existing at all.

# --- Process configuration --------------------------------------------------
# development enables the strict dotted-event-name check and relaxed defaults.
ENVIRONMENT=development
LOG_LEVEL=info

# --- Database ---------------------------------------------------------------
# The host-run inner loop reaches the Postgres that the dev overlay publishes.
# Inside the Compose stack this is overridden to the in-network @postgres:5432 form.
DATABASE_URL=postgresql+asyncpg://syncr:syncr@localhost:5432/syncr

# Read by Compose to initialize the postgres container.
POSTGRES_USER=syncr
POSTGRES_PASSWORD=syncr
POSTGRES_DB=syncr

# --- Google OAuth -----------------------------------------------------------
# The web-application OAuth client for the one Google integration: the anchor
# sources syncr reads and the single calendar it writes. Provisioning and the
# scope set are in docs/runbooks/google-oauth-verification.md.
#
# Both values live in the host secret file and never in the repository. Leaving
# them empty is a valid state: the stack boots and the connect flow reports that
# Google is not configured, so `just dev` works without them.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Which registered redirect URI this process uses. Google matches redirect URIs
# as exact strings, so this value must appear verbatim on the OAuth client. Three
# are registered: the https://syncr.app form for the deployed stack, and the two
# loopback forms for development.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/calendar-sources/google/callback
