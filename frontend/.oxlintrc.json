{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "import", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "no-console": "error",
    "eqeqeq": ["error", "always"],
    "import/no-cycle": "error",
    // React 19's automatic JSX runtime: nothing needs `React` in scope.
    "react/react-in-jsx-scope": "off",
    // A stylesheet and the DOM matchers are imported for their effect. That is what they are.
    "import/no-unassigned-import": "off",
    "unicorn/filename-case": "off"
  },
  "overrides": [
    {
      // THE IMPORT ZONES. `primitives` may import nothing above it, `layout` may import
      // `primitives`, and `domain` may import both. Enforcing it preserves the option of
      // extracting a generic kit later without paying for it now.
      //
      // EVERY GROUP DENIES A DIRECTORY, AND NONE ENUMERATES A MODULE. Three holes in this file
      // came from the other shape. A glob requiring a segment after the directory misses a bare
      // barrel; a glob naming `ui` cannot match a relative specifier; and a list naming
      // `api/client` permits `api/client.ts`, `api/keys.js` and `api/index`. Each denied a
      // mechanism rather than a capability. A directory pair, `**/x` and `**/x/**`, denies the
      // capability whatever file extension or barrel a caller reaches for.
      //
      // The one thing a kit component may read from outside its own layers is `contract/`, and it
      // is a separate directory for exactly this reason: it holds the Problem and Resource types a
      // component renders, and nothing that fetches. Keeping them under `api/` is what forced the
      // enumeration that kept springing leaks.
      "files": ["src/ui/primitives/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/layout", "**/layout/**", "**/domain", "**/domain/**"],
                "message": "primitives may import nothing above it."
              },
              {
                "group": [
                  "**/routes",
                  "**/routes/**",
                  "**/api",
                  "**/api/**",
                  "**/app",
                  "**/app/**",
                  "**/contract",
                  "**/contract/**"
                ],
                "message": "a primitive accepts dependencies as props: it never fetches, reads config, knows a route, or names a domain type. A control that needs a Problem is misfiled."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/ui/layout/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/domain", "**/domain/**"],
                "message": "layout may import primitives only. A container that knows a Block is a domain component."
              },
              {
                "group": [
                  "**/routes",
                  "**/routes/**",
                  "**/api",
                  "**/api/**",
                  "**/app",
                  "**/app/**",
                  "**/contract",
                  "**/contract/**"
                ],
                "message": "a layout container accepts dependencies as props: it never fetches, reads config, knows a route, or names a domain type."
              }
            ]
          }
        ]
      }
    },
    {
      // `domain` may read `contract/`, because a component that renders a Problem has to name one.
      // It may reach nothing under `api/`: the client is the fetching, `keys.ts` is cache
      // invalidation, and the generated schema is the fetching layer's own input.
      "files": ["src/ui/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/routes",
                  "**/routes/**",
                  "**/api",
                  "**/api/**",
                  "**/app",
                  "**/app/**"
                ],
                "message": "a kit component accepts dependencies as props: it never fetches, invalidates a cache, reads config, or knows a route. Read the types from contract/ instead."
              }
            ]
          }
        ]
      }
    },
    {
      // The committed checks read files one at a time on purpose: findings come out in a stable
      // order and memory stays bounded whatever the tree's size.
      "files": ["scripts/**"],
      "env": { "browser": false, "node": true },
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "src/testing/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "ignorePatterns": ["dist", "coverage", "src/api/schema.d.ts", "scripts/**/__fixtures__/**"]
}
