{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "import", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "no-console": "error",
    "eqeqeq": ["error", "always"],
    "import/no-cycle": "error",
    // React 19's automatic JSX runtime: nothing needs `React` in scope.
    "react/react-in-jsx-scope": "off",
    // A stylesheet and the DOM matchers are imported for their effect. That is what they are.
    "import/no-unassigned-import": "off",
    "unicorn/filename-case": "off"
  },
  "overrides": [
    {
      // THE IMPORT ZONES. `primitives` may import nothing above it, `layout` may import
      // `primitives`, and `domain` may import both. Enforcing it preserves the option of
      // extracting a generic kit later without paying for it now.
      //
      // EVERY PATTERN NAMES BOTH THE DIRECTORY AND ITS CONTENTS. `**/domain/**` alone requires a
      // segment after `domain`, so it misses a bare barrel import, and a pattern containing `ui`
      // cannot match a relative specifier at all, because a relative specifier has no `ui`
      // segment. Both shapes are this codebase's house style, so both were escaping.
      "files": ["src/ui/primitives/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/layout", "**/layout/**", "**/domain", "**/domain/**"],
                "message": "primitives may import nothing above it."
              },
              {
                "group": [
                  "**/routes",
                  "**/routes/**",
                  "**/api",
                  "**/api/**",
                  "**/app",
                  "**/app/**"
                ],
                "message": "a kit component accepts dependencies as props: it never fetches, reads config, or knows a route."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/ui/layout/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/domain", "**/domain/**"],
                "message": "layout may import primitives only. A container that knows a Block is a domain component."
              },
              {
                "group": [
                  "**/routes",
                  "**/routes/**",
                  "**/api",
                  "**/api/**",
                  "**/app",
                  "**/app/**"
                ],
                "message": "a kit component accepts dependencies as props: it never fetches, reads config, or knows a route."
              }
            ]
          }
        ]
      }
    },
    {
      // `domain` may read the api's TYPES, because a component that renders a Problem has to name
      // one. It may not reach the CLIENT, the KEY REGISTRY, or a hook.
      //
      // Naming all three matters, and getting it wrong here is what the previous pass missed. The
      // rule is not "may not reach a hook": the hook is not the fetching, `client.ts` is, and it
      // exports the one `createClient` instance. `keys.ts` is the invalidation surface. A zone that
      // bans the hook and permits either of those has banned a mechanism rather than a capability,
      // which is the same mistake the globs above made about a barrel import.
      "files": ["src/ui/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/routes",
                  "**/routes/**",
                  "**/api",
                  "**/api/client",
                  "**/api/keys",
                  "**/api/hooks",
                  "**/api/hooks/**",
                  "**/app",
                  "**/app/**"
                ],
                "message": "a kit component accepts dependencies as props: it may read the api's types, and may not reach the client, the key registry, a hook, a route, or the app."
              }
            ]
          }
        ]
      }
    },
    {
      // The committed checks read files one at a time on purpose: findings come out in a stable
      // order and memory stays bounded whatever the tree's size.
      "files": ["scripts/**"],
      "env": { "browser": false, "node": true },
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "src/testing/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "ignorePatterns": ["dist", "coverage", "src/api/schema.d.ts", "scripts/**/__fixtures__/**"]
}
