{
  "name": "syncr-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "syncr React SPA. Vite build, Tailwind v4 mapped onto the token layer, SWR over a client typed from the committed OpenAPI document.",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "codegen": "openapi-typescript openapi.json --output src/api/schema.d.ts",
    "lint:js": "oxlint --format=default",
    "lint:css": "stylelint \"src/**/*.css\" --formatter verbose",
    "lint:format": "prettier --check .",
    "fmt": "prettier --write .",
    "lint:tokens": "node scripts/validate-tokens/cli.ts",
    "lint:markup": "node scripts/lint-markup/cli.ts",
    "lint:channels": "node scripts/check-channels/cli.ts",
    "lint:imports": "node scripts/check-imports/cli.ts",
    "lint:contract": "node scripts/check-contract/cli.ts",
    "lint:bundle": "node scripts/check-bundle/cli.ts",
    "lint:contrast": "node scripts/audit-contrast/cli.ts",
    "lint:render": "node scripts/check-render/cli.ts"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.28.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "swr": "^2.4.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.76.0",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
